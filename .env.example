# Backend only. Never use VITE_ prefixes for these credentials.
# DB duy nhất là Supabase (Postgres + Storage). Không còn driver SQLite.
# Hai file env tách biệt, mỗi file CHỈ MỘT cặp SUPABASE_*:
#   .env    → mặc định ở development; production KHÔNG tự nạp file này.
#   .envdev → DB dev/drill, KHÔNG tự nạp. Chạy bằng `npm run dev:api:dev-db`,
#             `npm run dev:worker:dev-db`, `npm run worker:official:dev-db`
#             (tương đương `node --env-file=.envdev server/index.js`).
# Khai báo trùng key trong cùng một file thì dòng sau đè dòng trước và có thể
# trộn URL của project này với key của project khác.
# Luôn đặt OOTV2_EXPECTED_PROJECT_REF để API/worker/tool dừng ngay nếu trỏ nhầm project.
# Biến đã có trong môi trường (shell, `--env-file`, Vercel) THẮNG giá trị trong file env.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# OOTV2_EXPECTED_PROJECT_REF=<20 ký tự project ref trong SUPABASE_URL>
# Chọn file env khác thay cho .env (ví dụ OOTV2_ENV_FILE=.envdev).
# OOTV2_ENV_FILE=
# Guard chỉ áp cho URL dạng *.supabase.co|in (test double/PostgREST tự dựng được bỏ qua).
# DDL tooling only; never transfer to Vercel/worker and never prefix VITE_.
# SUPABASE_ACCESS_TOKEN=
# Alternative for existing migration tools (psql), not needed by runtime:
# SUPABASE_DB_URL=
OOTV2_API_HOST=127.0.0.1
OOTV2_API_PORT=3001
# Public HTTPS origin(s) of the web app, comma-separated (CSRF/same-origin allowlist).
# Same-origin requests through the reverse proxy are accepted without this.
# OOTV2_PUBLIC_ORIGIN=https://ootv2.example.edu.vn
# Trust X-Forwarded-* only from the local reverse proxy; default "loopback", 0 disables.
# OOTV2_TRUST_PROXY=loopback
# OOTV2_PYTHON_BIN=
# Thư mục cache tạm cho bot tải từ Supabase Storage (mặc định data/).
# OOTV2_DATA_DIR=data

# --- GitHub intake (H1): API chỉ resolve metadata repo + commit SHA, không clone/tải source ---
# Token đọc của BTC (GitHub App/token fine-grained). Chỉ đặt ở backend; KHÔNG đưa vào UI/log.
# OOTV2_GITHUB_TOKEN=
# Timeout mỗi request metadata tới GitHub API (ms).
# OOTV2_GITHUB_TIMEOUT_MS=8000
# H2: upload file qua HTTP mặc định TẮT (đội nộp qua GitHub). Bật =1 chỉ khi BTC dùng trusted-dev/import offline.
# OOTV2_ALLOW_ONLINE_UPLOAD=0
# Số commit SHA mới tối đa mỗi đội/giải được yêu cầu kiểm tra trong 24 giờ.
# OOTV2_GITHUB_DAILY_QUOTA=10

# --- Chạy công khai bằng Cloudflare Tunnel: MỘT origin cho web + API ---
# Origin HTTPS công khai của tunnel (dùng cho CSRF/same-origin allowlist và cookie Secure).
# OOTV2_PUBLIC_ORIGIN=https://live.example.com
# Tin X-Forwarded-* từ cloudflared chạy cùng máy (mặc định "loopback").
# OOTV2_TRUST_PROXY=loopback
# Express phục vụ luôn dist/ (SPA fallback); đặt 0 khi chỉ muốn chạy API.
# OOTV2_SERVE_DIST=1
# OOTV2_DIST_DIR=dist
# Ghi stdout/stderr của bot vào DB chung (chỉ đội sở hữu + admin đọc được); 0 để tắt.
# Worker từ chối khởi động khi chưa cấu hình được sandbox dùng được ngay.
# `trusted-dev` chạy bot Python trực tiếp trên host nên phải opt-in tường minh:
# `OOTV2_ALLOW_TRUSTED_DEV=1` (chỉ máy dev). Production phải dùng linux-sandbox.
# OOTV2_ALLOW_TRUSTED_DEV=1
# Không nhận Origin localhost ở production (mặc định tắt khi NODE_ENV=production).
# OOTV2_ALLOW_LOCAL_ORIGIN=0

# Production: dùng biến Vercel/systemd; chỉ OOTV2_ENV_FILE tuyệt đối do operator chọn mới nạp file.
# NODE_ENV=production
# Production cấm trusted-dev, WSL override, localhost origin và upload online compatibility.
# Worker Campus (VM Linux riêng, không đặt các biến sandbox trên Vercel):
# OOTV2_CAMPUS_SANDBOX=linux-sandbox
# OOTV2_SANDBOX_RUNNER=/srv/ootv2/current/sandbox/linux/run-bot.sh
# OOTV2_SANDBOX_ATTESTATION=/run/ootv2-sandbox-attestation.json
# OOTV2_SANDBOX_CGROUP_ROOT=/sys/fs/cgroup/ootv2-sandbox
# GET /api/health: public liveness; GET /api/ready: session admin + DB only, not worker acceptance.
