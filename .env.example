# Backend only. Never use VITE_ prefixes for these credentials.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
OOTV2_DB_DRIVER=supabase
OOTV2_API_HOST=127.0.0.1
OOTV2_API_PORT=3001
# Public HTTPS origin(s) of the web app, comma-separated (CSRF/same-origin allowlist).
# Same-origin requests through the reverse proxy are accepted without this.
# OOTV2_PUBLIC_ORIGIN=https://ootv2.example.edu.vn
# Trust X-Forwarded-* only from the local reverse proxy; default "loopback", 0 disables.
# OOTV2_TRUST_PROXY=loopback
# OOTV2_PYTHON_BIN=
# OOTV2_DATA_DIR=data
# Legacy/offline test runtime only: OOTV2_DB_DRIVER=sqlite

# --- Chạy công khai bằng Cloudflare Tunnel: MỘT origin cho web + API ---
# SQLite là driver của bản chạy thật (Supabase chỉ là profile lịch sử).
# OOTV2_DB_DRIVER=sqlite
# Origin HTTPS công khai của tunnel (dùng cho CSRF/same-origin allowlist và cookie Secure).
# OOTV2_PUBLIC_ORIGIN=https://live.example.com
# Tin X-Forwarded-* từ cloudflared chạy cùng máy (mặc định "loopback").
# OOTV2_TRUST_PROXY=loopback
# Express phục vụ luôn dist/ (SPA fallback); đặt 0 khi chỉ muốn chạy API.
# OOTV2_SERVE_DIST=1
# OOTV2_DIST_DIR=dist
# Ghi stdout/stderr của bot vào DB (chỉ đội sở hữu + admin đọc được); 0 để tắt.
# OOTV2_LIVE_BOT_OUTPUT=1
