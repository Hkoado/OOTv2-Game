{
  "name": "ottv2",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node server/index.js",
    "start:worker": "node server/worker.js",
    "dev:api": "node server/index.js",
    "dev:worker": "node server/worker.js",
    "dev:api:dev-db": "node --env-file=.envdev server/index.js",
    "dev:worker:dev-db": "node --env-file=.envdev server/worker.js",
    "worker:once": "node server/worker.js --once",
    "worker:drain": "node server/worker.js --drain",
    "worker:official": "node server/officialWorker.js",
    "worker:official:once": "node server/officialWorker.js --once",
    "worker:official:drain": "node server/officialWorker.js --drain",
    "worker:official:dev-db": "node --env-file=.envdev server/officialWorker.js",
    "worker:manual": "node server/officialWorker.js --manual",
    "worker:manual:once": "node server/officialWorker.js --manual --once",
    "worker:manual:drain": "node server/officialWorker.js --manual --drain",
    "worker:manual:dev-db": "node --env-file=.envdev server/officialWorker.js --manual",
    "drill:manual-worker": "node tools/cli/manual-worker-drill.js",
    "test:server": "node --test tests/*.test.js",
    "test:engine": "node --test tests/gameAdapter.test.js tests/campusEngine.test.js",
    "map:validate": "node tools/cli/validate-map.js",
    "replay:verify": "node tools/cli/verify-replay.js",
    "offline:bundle": "node tools/cli/offline-bundle.js",
    "demo:campus": "node tools/cli/demo-campus.js",
    "bots:drill": "node tools/cli/campus-bots-drill.js",
    "smoke:ui": "node tools/cli/smoke-ui.js",
    "db:verify": "node tools/cli/verify-shared-db.js",
    "worker:github": "node server/githubWorker.js",
    "worker:github:once": "node server/githubWorker.js --once",
    "worker:health": "node tools/cli/worker-health.js",
    "worker:config": "node tools/cli/worker-config.js --defaults",
    "db:production": "node tools/cli/production-db.js",
    "db:admin": "node tools/cli/create-admin.js",
    "db:check-github": "node tools/cli/check-github-db.js",
    "db:apply-migrations": "node tools/cli/apply-migrations.js",
    "db:sql": "node tools/cli/db-sql.js",
    "db:h4": "node tools/cli/h4-drill.js",
    "db:manual": "node tools/cli/manual-final-drill.js",
    "db:k2": "node tools/cli/k2-schedule-drill.js",
    "db:k2-open": "node tools/cli/k2-open-round.js",
    "db:cutoff": "node tools/cli/github-cutoff-drill.js",
    "github:cutoff": "node tools/cli/github-cutoff-sync.js",
    "github:worker": "node tools/cli/github-cutoff-worker.js --drain",
    "test": "node --test tests/*.test.js",
    "db:schema-drill": "node tools/cli/worker-schema-drill.js"
  },
  "dependencies": {
    "express": "^5.3.0",
    "lucide-react": "^0.475.0",
    "multer": "^2.5.0",
    "peerjs": "^1.5.5",
    "playhtml": "^2.14.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "vite": "^6.2.0"
  }
}
