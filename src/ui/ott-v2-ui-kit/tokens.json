{
  "meta": {
    "name": "OTT-v2 · parchment and dungeon",
    "version": "1.0.0",
    "scope": "Visual style only; layout and game rules are deliberately unspecified.",
    "cssPrefix": "ott"
  },
  "foundations": {
    "font": {
      "body": "'Be Vietnam Pro', system-ui, sans-serif",
      "display": "'Noto Serif', Georgia, serif"
    },
    "type": {
      "caption": { "size": "12px", "line-height": "1.5", "weight": "400" },
      "label": { "size": "13px", "line-height": "1.5", "weight": "600" },
      "body": { "size": "14px", "line-height": "1.6", "weight": "400" },
      "body-large": { "size": "16px", "line-height": "1.6", "weight": "400" },
      "heading-small": { "size": "18px", "line-height": "1.4", "weight": "600" },
      "heading": { "size": "24px", "line-height": "1.35", "weight": "600" },
      "display": { "size": "32px", "line-height": "1.3", "weight": "600" },
      "tracking-label": "0.04em"
    },
    "space": { "0": "0px", "1": "2px", "2": "4px", "3": "8px", "4": "12px", "5": "16px", "6": "20px", "7": "24px", "8": "32px", "9": "40px", "10": "48px" },
    "border": { "hairline": "1px", "strong": "2px", "focus": "2px" },
    "radius": { "none": "0px", "small": "2px", "round": "50%" },
    "shadow": { "none": "none" },
    "texture": { "grain-opacity": "0.03", "script-opacity": "0.035", "stone-opacity": "0.04", "max-opacity": "0.06" },
    "motion": { "fast": "120ms", "normal": "180ms", "reduced": "0ms", "ease": "ease-out" },
    "layer": { "decoration": "0", "content": "1", "floating": "10", "dialog": "20", "notification": "30" }
  },
  "components": {
    "control": { "height": "40px", "height-dense": "36px", "padding-inline": "12px", "gap": "8px" },
    "panel": { "padding": "16px", "gap": "12px" },
    "focus": { "offset": "3px" },
    "icon": { "utility": "20px", "piece-small": "32px", "piece": "40px", "preview": "48px", "stroke": "2px" },
    "art": { "safe-inset": "6%", "piece-coverage": "84%", "terrain-coverage": "96%" },
    "play": { "tile-min": "44px", "tile-preferred": "56px", "tile-max": "76px", "grid-line": "1px" }
  },
  "themes": {
    "light": {
      "color": {
        "bg": { "canvas": "#efe2c6", "surface": "#f4e8ce", "subtle": "#e6d7b6", "hover": "#e3d1ac", "selected": "#ddc99f", "disabled": "#e7ddc8" },
        "text": { "primary": "#3c3328", "secondary": "#60533f", "disabled": "#8b7b63", "on-accent": "#fff8e9" },
        "border": { "subtle": "#b4a07b", "control": "#897454", "strong": "#66523b" },
        "accent": { "default": "#7c4b2d", "hover": "#633b24", "pressed": "#4c2c1c" },
        "focus": "#365f70",
        "status": { "success": "#3d613f", "warning": "#805015", "danger": "#963f32", "info": "#365f70" },
        "team": { "red": "#8e4439", "blue": "#3b6267" },
        "piece": { "surface": "#f5f0e5", "ink": "#242424" },
        "terrain": { "fire": "#df873a", "water": "#3e9da8", "bush": "#748e42", "chasm": "#49473f" },
        "terrain-surface": { "fire": "#dec09c", "water": "#b4cfca", "bush": "#c0c99b", "chasm": "#b7ad94" }
      }
    },
    "dark": {
      "color": {
        "bg": { "canvas": "#202429", "surface": "#282d31", "subtle": "#313638", "hover": "#3b4141", "selected": "#49493d", "disabled": "#303438" },
        "text": { "primary": "#e0d7c2", "secondary": "#c0bba7", "disabled": "#858577", "on-accent": "#202429" },
        "border": { "subtle": "#55594e", "control": "#858b7b", "strong": "#b2ad96" },
        "accent": { "default": "#d1ad70", "hover": "#e0bf87", "pressed": "#b99860" },
        "focus": "#a9d1dc",
        "status": { "success": "#b0c498", "warning": "#e1bf79", "danger": "#efa396", "info": "#a9d1dc" },
        "team": { "red": "#8e4439", "blue": "#3b6267" },
        "piece": { "surface": "#e5dfd1", "ink": "#242424" },
        "terrain": { "fire": "#df873a", "water": "#3e9da8", "bush": "#748e42", "chasm": "#49473f" },
        "terrain-surface": { "fire": "#8d6748", "water": "#628b89", "bush": "#6f8058", "chasm": "#65685b" }
      }
    }
  }
}
